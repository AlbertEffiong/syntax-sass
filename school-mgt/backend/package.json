{
  "name": "syntax-saas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Syntax SaaS - secure, modular multi-tenant School Management & Result Checking API (Node.js + TypeScript + Express + MongoDB).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx test/integration.ts",
    "test:client": "tsx test/frontendClient.ts",
    "seed:owner": "tsx src/scripts/seedOwner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.5.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
