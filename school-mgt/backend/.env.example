# ============================================================================
# Syntax SaaS Backend - Example environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ============================================================================

# Runtime
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/syntax_saas

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Use a long, random secret in production (e.g. `openssl rand -hex 48`).
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated list of trusted frontend origins (CORS allowlist).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookies: set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
# Optional cookie domain (leave blank for host-only cookies).
COOKIE_DOMAIN=

# Rate limiting for authentication routes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Password hashing cost.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# OPay manual bank-transfer verification
# ---------------------------------------------------------------------------
OPAY_ACCOUNT_NUMBER=8168998060
OPAY_ACCOUNT_NAME=Albert Effiong

# ---------------------------------------------------------------------------
# Bootstrap owner (used only by `npm run seed:owner`)
# ---------------------------------------------------------------------------
OWNER_NAME=SaaS Owner
OWNER_EMAIL=owner@syntaxsaas.io
OWNER_PASSWORD=ChangeMe@123
